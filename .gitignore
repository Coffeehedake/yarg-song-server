# build output
/bin/
/dist/
*.exe
*.test

# CI works inside the project directory, because the runner is a shell executor
# and there is nowhere else that is both writable and cached: .toolchain/ holds
# the pinned Go distribution the pipeline fetches, .cache/ holds GOPATH, GOCACHE
# and GOMODCACHE. Neither is ever committed, and both are safe to delete.
/.toolchain/
/.cache/

# local runtime state
/data/
*.db
*.sqlite
config.local.*
.env

# song fixtures are large and often copyrighted - never commit them
/testdata/songs/
# generated libraries: mkcorpus writes /corpus, mkscale writes /scale-corpus by
# default, and a scale run is tens of thousands of files. Committing one by
# accident is the kind of mistake that is easier to prevent than to undo.
/corpus/
/scale-corpus/
*.sng
# ...except the reference archives, which are ours, tiny, and the only thing
# that proves the reader agrees with the reference encoder rather than with our
# own test fixture.
!internal/sng/testdata/*.sng
*.ogg
*.opus
*.mp3
*.wav
*.aiff
*.mogg
*.con
*_rb3con

# Arbiter's archived handoffs. They are plaintext working notes, they mention
# internal hostnames and infrastructure, and this repo is mirrored publicly to
# GitHub -- so a stray `git add -A` would publish them. None has ever been
# tracked; this makes that deliberate rather than lucky. Delete the folder
# freely, nothing reads it back.
/.arbiter/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
